  tips:
  - "\" \uD2F0\uCF13\uC73C\uB85C \uC0AC\uB3C4\uB4E4\uC744 \uBF51\uC544 \uC801\uB4E4\uC744
    \uBB3C\uB9AC\uCE58\uC138\uC694!\""
  - "\" \uC6B4\uC774 \uC5C6\uC5B4\uC11C 3\uC131\uC774 \uC548\uB098\uC628\uB2E4\uACE0\uC694?
    \n\uAC74\uBB3C\uC5D0\uC11C \uC5D8\uB9AC\uD504 \uB3C4\uBC15\uC744 \uD574\uBCF4\uC138\uC694!\""
  - "\" \uC5D8\uB2E4\uC778 \uC774\uC0C1\uC758 \uC0AC\uB3C4\uB4E4\uC740 \uD2B9\uBCC4\uD55C
    \uD0A4\uC6CC\uB4DC\uB97C \n\uCC44\uD305\uCC3D\uC5D0 \uCCD0\uC57C \uC870\uD569\uC774
    \uB429\uB2C8\uB2E4.\""
  - "\" \uB0AE\uC740 \uD655\uB960\uB85C \uD788\uB4E0 \uCE90\uB9AD\uD130\uB4E4\uC774
    \uB4F1\uC7A5\uD569\uB2C8\uB2E4.\" - \uBBF8\uAD6C\uD604"
  - "\" \uC73C\uC5D0\uC5D0\uC5E5 \" "
  - "\" \uC804\uC124\uB85C\uB9CC \uC804\uD574\uC838\uC624\uB294 \uBCFC\uB530\uAD6C\uB97C
    \uC18C\uD658\uD574\uBCF4\uC790\""
